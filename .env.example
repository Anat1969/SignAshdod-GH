# Supabase connection (client-side, safe to expose — protected by Row Level Security).
# Copy this file to .env.local for local development and fill in the values from
# your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional: override the app base path (defaults to /SignAshdod-GH/ for GitHub Pages).
# Use "/" when serving from a custom domain or the domain root.
# VITE_BASE=/
