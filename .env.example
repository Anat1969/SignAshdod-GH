# Appwrite connection (client-side, safe to expose — access is controlled by
# Appwrite permissions on the server, not by hiding these values).
# Copy this file to .env.local for local development and fill in the values
# from your Appwrite project (Console -> Settings / Overview).

# Your project's API endpoint, e.g. https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
# Project ID from the Appwrite console.
VITE_APPWRITE_PROJECT_ID=YOUR_PROJECT_ID

# These have sensible defaults and only need to be set if you change the IDs.
VITE_APPWRITE_DATABASE_ID=signash
VITE_APPWRITE_BUCKET_ID=uploads
VITE_APPWRITE_REQUESTS_COLLECTION=signage_requests
VITE_APPWRITE_NOTES_COLLECTION=request_notes

# Optional: override the app base path (defaults to /SignAshdod-GH/ for GitHub Pages).
# Use "/" when serving from a custom domain or the domain root.
# VITE_BASE=/
