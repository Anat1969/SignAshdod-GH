{
  "name": "SignageRequest",
  "type": "object",
  "properties": {
    "request_type": {
      "type": "string",
      "enum": [
        "project_sign",
        "talking_fence"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05d1\u05e7\u05e9\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "needs_revision",
        "approved",
        "rejected"
      ],
      "default": "draft",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "applicant_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d1\u05e7\u05e9"
    },
    "applicant_phone": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05e0\u05d9\u05d9\u05d3"
    },
    "applicant_email": {
      "type": "string",
      "title": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05de\u05d1\u05e7\u05e9"
    },
    "site_address": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d0\u05ea\u05e8"
    },
    "permit_nature": {
      "type": "string",
      "title": "\u05de\u05d4\u05d5\u05ea \u05d4\u05d4\u05d9\u05ea\u05e8"
    },
    "permit_number": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d9\u05ea\u05e8"
    },
    "project_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "developer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d9\u05d6\u05dd"
    },
    "architect_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d0\u05d3\u05e8\u05d9\u05db\u05dc"
    },
    "contractor_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e7\u05d1\u05dc\u05df \u05d4\u05d1\u05d9\u05e6\u05d5\u05e2"
    },
    "contractor_license": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05e8\u05d9\u05e9\u05d9\u05d5\u05df \u05e7\u05d1\u05dc\u05df"
    },
    "engineer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05d4\u05e0\u05d3\u05e1"
    },
    "engineer_license": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05e8\u05d9\u05e9\u05d9\u05d5\u05df \u05de\u05d4\u05e0\u05d3\u05e1"
    },
    "site_manager_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05e0\u05d4\u05dc \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4"
    },
    "safety_officer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d0\u05d7\u05e8\u05d0\u05d9 \u05d4\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea"
    },
    "company_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d7\u05d1\u05e8\u05d4"
    },
    "company_po_box": {
      "type": "string",
      "title": "\u05ea.\u05d3. \u05d7\u05d1\u05e8\u05d4"
    },
    "company_address": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05e0\u05db\u05e1"
    },
    "fence_total_length_meters": {
      "type": "number",
      "title": "\u05e1\u05d4\u05f4\u05db \u05d0\u05d5\u05e8\u05da \u05d4\u05d2\u05d3\u05e8 \u05d1\u05de\u05d8\u05e8\u05d9\u05dd"
    },
    "fence_developer_percent": {
      "type": "number",
      "title": "\u05d0\u05d7\u05d5\u05d6 \u05d7\u05dc\u05e7 \u05d4\u05d9\u05d6\u05dd"
    },
    "fence_municipality_percent": {
      "type": "number",
      "title": "\u05d0\u05d7\u05d5\u05d6 \u05d7\u05dc\u05e7 \u05d4\u05e2\u05d9\u05e8\u05d9\u05d9\u05d4"
    },
    "sign_example_file": {
      "type": "string",
      "title": "\u05d3\u05d5\u05d2\u05de\u05d0 \u05e9\u05dc \u05d4\u05e9\u05dc\u05d8 A4"
    },
    "organization_plan_file": {
      "type": "string",
      "title": "\u05ea\u05db\u05e0\u05d9\u05ea \u05d4\u05ea\u05d0\u05e8\u05d2\u05e0\u05d5\u05ea A3"
    },
    "permit_visualization_file": {
      "type": "string",
      "title": "\u05d4\u05d3\u05de\u05d9\u05d9\u05ea \u05d4\u05d9\u05ea\u05e8"
    },
    "fence_diagram_file": {
      "type": "string",
      "title": "\u05ea\u05e8\u05e9\u05d9\u05dd \u05de\u05d9\u05d3\u05d5\u05ea \u05d2\u05d3\u05e8"
    },
    "fence_3d_render_file": {
      "type": "string",
      "title": "\u05d4\u05d3\u05de\u05d9\u05d9\u05ea \u05ea\u05dc\u05ea \u05de\u05d9\u05de\u05d3 \u05d2\u05d3\u05e8"
    },
    "developer_signature_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d7\u05ea\u05d9\u05de\u05ea \u05d9\u05d6\u05dd"
    },
    "city_architect_approved": {
      "type": "boolean",
      "default": false,
      "title": "\u05d7\u05ea\u05d9\u05de\u05ea \u05d0\u05d3\u05e8\u05d9\u05db\u05dc \u05d4\u05e2\u05d9\u05e8"
    },
    "signage_committee_approved": {
      "type": "boolean",
      "default": false,
      "title": "\u05d7\u05ea\u05d9\u05de\u05ea \u05d5\u05e2\u05d3\u05ea \u05e9\u05d9\u05dc\u05d5\u05d8"
    },
    "municipal_supervision_approved": {
      "type": "boolean",
      "default": false,
      "title": "\u05d7\u05ea\u05d9\u05de\u05ea \u05e4\u05d9\u05e7\u05d5\u05d7 \u05e2\u05d9\u05e8\u05d5\u05e0\u05d9"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "reviewer_notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d1\u05d5\u05d3\u05e7"
    }
  },
  "required": [
    "request_type",
    "applicant_name",
    "applicant_phone",
    "applicant_email",
    "site_address"
  ]
}