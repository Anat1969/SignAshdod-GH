{
  "name": "RequestNote",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e7\u05e9\u05d4"
    },
    "note_text": {
      "type": "string",
      "title": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05e2\u05e8\u05d4"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "general",
        "missing_document",
        "correction_needed",
        "approval",
        "rejection"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05d4\u05e2\u05e8\u05d4"
    },
    "sent_to_applicant": {
      "type": "boolean",
      "default": false,
      "title": "\u05e0\u05e9\u05dc\u05d7 \u05dc\u05de\u05d1\u05e7\u05e9"
    }
  },
  "required": [
    "request_id",
    "note_text",
    "note_type"
  ]
}